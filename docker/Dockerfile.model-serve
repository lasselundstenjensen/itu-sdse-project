
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install Person 1's dependencies
COPY docker/requirements.txt ./docker/requirements.txt
COPY models/model/requirements.txt ./model-requirements.txt

RUN pip install --no-cache-dir \
    -r docker/requirements.txt \
    -r model-requirements.txt

# Copy application code
COPY vial_classifier/ ./vial_classifier/

# Copy the exported model
COPY models/model/ ./models/model/

# Copy drift detection baseline
COPY artifacts/drift_baseline_stats.json ./artifacts/drift_baseline_stats.json

# Create directory for inference logs
RUN mkdir -p artifacts

# Expose API port
EXPOSE 5001

# Start Uvicorn
CMD ["uvicorn", "vial_classifier.serving.api:app", "--host", "0.0.0.0", "--port", "5001"]
